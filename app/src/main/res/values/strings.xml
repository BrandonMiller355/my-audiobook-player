    <string name="notes_empty_title">No notes yet.</string>
    <string name="notes_empty_body">Tap Mark on the player to keep the spot you are listening to. A mark anchors fifteen seconds earlier, so the passage that prompted it plays back with it. Add the words whenever you like.</string>
