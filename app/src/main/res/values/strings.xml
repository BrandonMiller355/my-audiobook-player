<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Audiobooks</string>

    <!-- Library -->
    <string name="library_title">Library</string>
    <string name="library_add">Add a book</string>
    <string name="library_add_folder">Add a folder</string>
    <string name="library_add_file">Add a single file</string>
    <string name="library_cover">Cover art</string>

    <!-- The resume card. Set in caps because the style that renders it is a tracked-out
         uppercase label; there is no sentence-case form of it anywhere. -->
    <string name="library_resume_label">KEEP LISTENING</string>
    <string name="library_resume_remaining">%1$s left</string>

    <!-- A row's second line: chapter count, and total duration once it is known. -->
    <string name="library_row_meta">%1$d ch · %2$s</string>
    <string name="library_row_meta_no_duration">%1$d ch</string>
    <string name="library_unavailable">Source unavailable — tap to relink</string>

    <string name="library_empty_title">Nothing here yet.</string>
    <string name="library_empty_body">Point the app at a folder of audio files or a single .m4b, and it appears here with its chapters.</string>
    <string name="library_empty_folder">Choose a folder</string>
    <string name="library_empty_file">Choose a single .m4b</string>
    <string name="library_empty_privacy">STAYS ON THIS DEVICE · NO ACCOUNT</string>

    <string name="library_remove_title">Remove %1$s?</string>
    <string name="library_remove_body">Removes the book from your library. Your files stay exactly where they are.</string>

    <!-- Shown only when the book has notes. Notes are the one thing in this app the user wrote
         themselves, so the one path that destroys them says so first (add-notes-and-bookmarks
         design D9). -->
    <plurals name="library_remove_notes">
        <item quantity="one">It also deletes the %1$d note you took in it. That cannot be undone.</item>
        <item quantity="other">It also deletes the %1$d notes you took in it. That cannot be undone.</item>
    </plurals>
    <string name="library_remove_confirm">Remove from library</string>
    <string name="library_remove_cancel">Keep it</string>

    <!-- Player -->
    <string name="player_back">Back to library</string>
    <string name="player_unknown_book">Book not found</string>
    <string name="player_connecting">Connecting…</string>
    <string name="player_play">Play</string>
    <string name="player_pause">Pause</string>

    <!-- Uppercased where it is drawn, so the chapter title keeps its own casing in the string. -->
    <string name="player_chapter_line">CH %1$d/%2$d — %3$s</string>

    <string name="player_seek_back_1m">Back one minute</string>
    <string name="player_seek_back_10s">Back ten seconds</string>
    <string name="player_seek_forward_10s">Forward ten seconds</string>
    <string name="player_seek_forward_1m">Forward one minute</string>

    <!-- Captions under the seek controls. Labels, not tap targets — the descriptions above are
