    <string name="player_speed_caption">SPEED</string>
    <string name="player_speed_value">%1$s×</string>

    <!-- Notes and bookmarks. The footer's middle third pauses and opens the new note for writing
         (add-notes-and-bookmarks design D6), so its sub-label states what it has collected. -->
    <string name="player_mark">Mark</string>
    <plurals name="player_mark_caption">
        <item quantity="one">%1$d NOTE</item>
        <item quantity="other">%1$d NOTES</item>
    </plurals>

    <!-- Notes screen -->
    <string name="notes_title">Notes</string>

